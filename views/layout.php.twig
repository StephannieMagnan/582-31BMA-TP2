{#
    Gabarit commun à toutes les pages : en-tête, menu, messages et pied de page.
    Chaque vue remplit le bloc « contenu » et peut changer le bloc « titre ».
#}
<!DOCTYPE html>
<html lang="fr-CA">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block titre %}{% endblock %} | {{ nom_site }}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Karla:wght@400;500;700&display=swap">
    <link rel="stylesheet" href="{{ base }}/css/style.css">
</head>
<body>
    {% set liensMenu = {
        'accueil':    { 'adresse': '/',                   'libelle': 'Accueil' },
        'livres':     { 'adresse': '/livres',             'libelle': 'Catalogue' },
        'auteurs':    { 'adresse': '/auteurs',            'libelle': 'Auteurs' },
        'editeurs':   { 'adresse': '/editeurs',           'libelle': 'Éditeurs' },
        'categories': { 'adresse': '/categories',         'libelle': 'Catégories' },
        'inventaire': { 'adresse': '/livres/inventaire',  'libelle': 'Inventaire' },
    } %}

    <header class="entete">
        <div class="entete__interieur">
            <a class="logo" href="{{ base }}/">
                <svg class="logo__sigle" viewBox="0 0 32 32" aria-hidden="true">
                    <circle cx="16" cy="16" r="14" />
                    <path d="M3.9 9 H28.1 L16 30 Z" />
                    <circle class="logo__oeil" cx="16" cy="15" r="2.6" />
                </svg>
                {{ nom_site }}
            </a>

            <nav class="menu" aria-label="Navigation principale">
                <ul>
                    {% for cle, lien in liensMenu %}
                        <li>
                            <a href="{{ base }}{{ lien.adresse }}" {% if cle == menu|default('') %}aria-current="page"{% endif %}>
                                {{ lien.libelle }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            <a class="bouton bouton--clair" href="{{ base }}/livre/create">Ajouter un livre</a>
        </div>
    </header>

    <main class="contenu">
        {% for message in messages %}
            <p class="message message--{{ message.type }}" role="status">{{ message.texte }}</p>
        {% endfor %}

        {% block contenu %}{% endblock %}
    </main>

    <footer class="pied">
        <p>{{ nom_site }}, projet de Programmation Web avancée (582-31VB-MA), Collège de Maisonneuve.</p>
    </footer>

    <script src="{{ base }}/js/confirmation.js"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
